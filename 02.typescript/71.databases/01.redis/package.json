        "start": "ts-node src/index.ts",

        "string": "ts-node src/01.string.ts",

        "hash": "ts-node src/02.hash.ts",

        "list": "ts-node src/03.list.ts",

        "set": "ts-node src/04.set.ts",

        "zset": "ts-node src/05.zset.ts",

        "key": "ts-node src/06.key-expire.ts",

        "tx": "ts-node src/07.transaction-pipeline.ts",

