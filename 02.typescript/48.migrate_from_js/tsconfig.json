{
    "compilerOptions": {
        // 初始阶段：宽松配置
        "target": "ES2020",
        "module": "commonjs",
        "strict": false,
        "noImplicitAny": false,
        "strictNullChecks": false,
        "skipLibCheck": true,

        // 允许 JS 文件
        "allowJs": true,
        "checkJs": false,

        // 添加 Node.js 类型支持
        "types": ["node"],
        
        // 启用 lib 以支持 DOM 和 ES2015
        "lib": ["es2020", "dom"],

        // 输出目录
        "outDir": "./dist",
        "rootDir": "./src"
    },
    "include": ["src/**/*", "*.ts", "*.js"],
    "exclude": ["node_modules", "dist"]
}
