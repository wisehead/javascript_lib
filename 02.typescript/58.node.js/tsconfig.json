{
    "compilerOptions": {
        // 编译目标：ES2020
        "target": "ES2020",

        // 模块系统：CommonJS（Node.js 原生支持）
        "module": "commonjs",

        // 启用的库
        "lib": ["ES2020"],

        // 输出目录
        "outDir": "./dist",

        // 源码根目录
        "rootDir": "./src",

        // 严格模式（始终开启）
        "strict": true,

        // ES 模块互操作
        "esModuleInterop": true,

        // 跳过库检查
        "skipLibCheck": true,

        // 强制文件名大小写一致
        "forceConsistentCasingInFileNames": true,

        // 模块解析策略
        // "moduleResolution": "node",

        // 生成声明文件
        "declaration": true
    },
    // 要编译的文件
    "include": ["src/**/*"],
    // 排除的文件
    "exclude": ["node_modules", "dist"]
}